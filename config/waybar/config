{
"include": "~/.config/waybar/modules",
"layer": "top",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 10,
"fixed-center": true,
"ipc": true,

"modules-left": [
    "memory",
    "disk",
    "mpris",
    "custom/obs.py"
],

"modules-center": ["hyprland/workspaces#cam"],

"modules-right": [
    "custom/backlight",
    "backlight/slider",
    "custom/speaker",
    "pulseaudio/slider",
    "battery#cam",
    "clock#cam",
    "tray",
],

// --- Module configurations --- //

"hyprland/workspaces#cam": {
    "active-only": false,
    "all-outputs": true,
    "format": "{icon}",
    "show-special": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = {id}})'",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "persistent-workspaces": {
        "1": [],
        "2": [],
        "3": [],
        "4": []
    },
    "format-icons": {
        "1": "1",
        "2": "2",
        "3": "3",
        "4": "4"
    }
},

"hyprland/window#cam": {
    "format": "💻   {title}",
    "max-length": 100,
    "rewrite": {
        "(.*) — Mozilla Firefox": " $1",
        "(.*) - zsh": "> [$1]"
    },
    "separate-outputs": true
},

"clock#cam": {
    "interval": 1,
    "format": "{:%b, %d, %H:%M:%S}",
    "max-length": 25
},

"battery#cam": {
    "interval": "0.1",
    "align": 0,
    "rotate": 0,
    "full-at": 100,
    "design-capacity": false,
    "states": {"critical": 15},
    "format": "{capacity}%  {icon}",
    "format-charging": "   {capacity}%",
    "format-plugged": "󱘖    {capacity}%",
    "format-full": "{icon}      Full",
    "format-alt": "{icon}   {time}",
    "format-icons": ["", "", "", "", ""],
    "format-time": "{H}h {M}min",
    "tooltip": true,
    "tooltip-format": "{timeTo} {power}w"
},

"pulseaudio/slider": {
    "min": 10,
    "max": 100,
    "orientation": "horizontal"
},

"custom/speaker": {
    "exec": "echo '🔊'",
    "interval": 1,
    "format": "{}"
},

"backlight/slider": {
    "min": 10,
    "max": 100,
    "orientation": "horizontal"
},

"custom/backlight": {
    "exec": "echo '✨'",
    "interval": 1,
    "format": "{}"
},



"memory": {
    "format": "{used}/{total} GB",
    "format-icons": [""],
    "max-length": 30,
    "interval": "0.1"
},

"disk": {
    "format": "{used}",
    "interval": 60,
    "max-length": 50,
    "format-icons": [""]
},

"mpris": {
    "format": "{title}   🎼",
    "max-length": 100,
    "tooltip": true,
    "tooltip-format": "{artist} - {album} ({title})",
    "on-click": "playerctl next",
    "on-click-right": "playerctl previous",
    "on-scroll-up": "playerctl volume 5%+",
    "on-scroll-down": "playerctl volume 5%-",
    "interval": "0.1",
},
"custom/obs.py": {
    "exec": "~/.config/waybar/obs.py",
    "interval": 2,
    "format": "{output}",
    "tooltip": true,
    "tooltip-format": "OBS Status"
}
}
