[global]
offset = (20, 20)
origin = top-right
font = JetBrainsMono Nerd Font 10
corner_radius = 12
frame_width = 2
gap_size = 10

transparency = 10
[urgency_low]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#89b4fa"

[urgency_normal]
background = "#1e1e2e"
foreground = "#ffffff"
frame_color = "#89b4fa"

[urgency_critical]
background = "#1e1e2e"
foreground = "#f38ba8"
frame_color = "#f38ba8"
